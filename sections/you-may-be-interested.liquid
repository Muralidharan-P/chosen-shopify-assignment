<section
  id="tt-best-sellers-{{ section.id }}"
  class="tt-best-sellers"
>
  <div class="tt-best-sellers__heading">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="tt-best-sellers__slider">

    <div class="tt-best-sellers__viewport">
      <div class="tt-best-sellers__products">

        {% assign selected_products = 0 %}

{% for i in (1..12) %}
  {% assign product_key = 'product_' | append: i %}
  {% assign selected_product = section.settings[product_key] %}

  {% if selected_product != blank %}
    {% assign selected_products = selected_products | plus: 1 %}

    <div class="tt-best-sellers__product">
      {% render 'product-card', product_card_product: selected_product %}
    </div>
  {% endif %}
{% endfor %}

{% if selected_products == 0 %}
  {% for i in (1..5) %}
    <div class="tt-best-sellers__product">
      {{ 'product-' | append: i | placeholder_svg_tag }}
    </div>
  {% endfor %}
{% endif %}

      </div>
    </div>


    <!-- BOTTOM NAVIGATION -->

    <div class="tt-best-sellers__bottom">

      <div
        class="tt-best-sellers__dots"
        aria-label="Product slider navigation"
      ></div>


      <div class="tt-best-sellers__arrows">


        <!-- LEFT ARROW -->

        <button
          type="button"
          class="tt-best-sellers__arrow tt-best-sellers__prev"
          aria-label="Previous products"
        >

          {% if section.settings.left_arrow != blank %}

            {{
              section.settings.left_arrow
              | image_url: width: 80
              | image_tag:
                loading: 'lazy',
                class: 'tt-best-sellers__arrow-image',
                alt: 'Previous'
            }}

          {% else %}

            <span>←</span>

          {% endif %}

        </button>


        <!-- RIGHT ARROW -->

        <button
          type="button"
          class="tt-best-sellers__arrow tt-best-sellers__next"
          aria-label="Next products"
        >

          {% if section.settings.right_arrow != blank %}

            {{
              section.settings.right_arrow
              | image_url: width: 80
              | image_tag:
                loading: 'lazy',
                class: 'tt-best-sellers__arrow-image',
                alt: 'Next'
            }}

          {% else %}

            <span>→</span>

          {% endif %}

        </button>

      </div>

    </div>

  </div>
</section>



{% style %}

  /* =========================
     MAIN SECTION
  ========================= */

  #tt-best-sellers-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    border-top: 1px solid #111;
    border-bottom: 1px solid #111;
  }


  /* =========================
     HEADING
  ========================= */

  #tt-best-sellers-{{ section.id }} .tt-best-sellers__heading {
    display: flex;
    align-items: center;
    padding: 0 8px;
    border-bottom: 1px solid #111;
    margin-top:30px;
    padding-bottom:20px;
  }

  #tt-best-sellers-{{ section.id }} .tt-best-sellers__heading h2 {
    margin: 0;
    font-size: 80px;
    line-height: 1;
    font-weight: 500;

  }


  /* =========================
     SLIDER
  ========================= */

  #tt-best-sellers-{{ section.id }} .tt-best-sellers__viewport {
    width: 100%;
    overflow: hidden;
  }

  #tt-best-sellers-{{ section.id }} .tt-best-sellers__products {
    display: flex;
    width: 100%;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }

  #tt-best-sellers-{{ section.id }} .tt-best-sellers__products::-webkit-scrollbar {
    display: none;
  }

  #tt-best-sellers-{{ section.id }} .tt-best-sellers__product {
    flex: 0 0 20%;
    min-width: 0;
    scroll-snap-align: start;
    border-right: 1px solid #111;
  }

  #tt-best-sellers-{{ section.id }} .tt-best-sellers__product:last-child {
    border-right: 0;
  }


  /* =========================
     PRODUCT CARD
  ========================= */

  #tt-best-sellers-{{ section.id }} .tt-product-card {
    width: 100%;
    height: 100%;
  }

  #tt-best-sellers-{{ section.id }} .tt-product-card__image-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }


  /* =========================
     IMAGE
  ========================= */

  #tt-best-sellers-{{ section.id }} .tt-product-card__image-wrapper {
    position: relative;
    width: 100%;
    height: 400px;
    overflow: hidden;
    border-bottom: 1px solid #111;
  }

  #tt-best-sellers-{{ section.id }} .tt-product-card__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    padding: 18px 8px;

    transition:
      transform 0.35s ease,
      opacity 0.18s ease;
  }


  /* IMAGE SLIDE OUT */

  #tt-best-sellers-{{ section.id }} .tt-product-card__main-image.is-sliding-out {
    transform: translateX(-45px);
    opacity: 0;
  }


  /* IMAGE ENTER */

  #tt-best-sellers-{{ section.id }} .tt-product-card__main-image.is-sliding-in {
    transform: translateX(45px);
    opacity: 0;
  }


  /* PRODUCT HOVER */

  #tt-best-sellers-{{ section.id }}
  .tt-product-card:hover
  .tt-product-card__image:not(.is-sliding-out):not(.is-sliding-in) {
    transform: scale(1.03);
  }


  #tt-best-sellers-{{ section.id }} .tt-product-card__placeholder {
    width: 100%;
    height: 100%;
  }


  /* =========================
     BADGES (Best Seller + Discount)
  ========================= */

  #tt-best-sellers-{{ section.id }} .tt-product-card__badges {
    position: absolute;
    top: 7px;
    left: 7px;
    right: 7px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
  }

  #tt-best-sellers-{{ section.id }} .tt-product-card__badge {
    padding: 3px 6px;
    color: #fff;
    font-size: 15px;
    line-height: 1;
    font-weight: 500;
  }

  #tt-best-sellers-{{ section.id }} .tt-product-card__badge--bestseller {
    background: #5947d6;
  }

  #tt-best-sellers-{{ section.id }} .tt-product-card__badge--discount {
    background: #d64545;
  }

  #tt-best-sellers-{{ section.id }} .tt-product-card__badge--discount[hidden] {
    display: none !important;
  }


  /* =========================
     PRODUCT CONTENT
  ========================= */

  #tt-best-sellers-{{ section.id }} .tt-product-card__content {
    min-height: 78px;
    padding: 9px;
gap:15px;
    display: flex;
    flex-direction: column;
  }


  /* TITLE */

  #tt-best-sellers-{{ section.id }} .tt-product-card__title {
    display: block;
    margin: 0 0 9px;

    color: #111;
    text-decoration: none;

    font-size: 24px;
    line-height: 1.2;
    font-weight: 500;
  }


  /* =========================
     SWATCHES
  ========================= */

  #tt-best-sellers-{{ section.id }} .tt-product-card__swatches {
    display: flex;
    align-items: center;
    gap: 2px;

    min-height: 16px;
    margin-bottom: 8px;
  }


  #tt-best-sellers-{{ section.id }} .tt-product-card__swatch {
    width: 30px;
    height: 30px;

    padding: 0;
    display: block;
    flex: 0 0 30px;

    border: 0;
    outline: 0;

    background-size: cover;
    background-position: center;

    cursor: pointer;

    appearance: none;
    -webkit-appearance: none;

    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }


  #tt-best-sellers-{{ section.id }} .tt-product-card__swatch:hover,
  #tt-best-sellers-{{ section.id }} .tt-product-card__swatch.is-active {
    transform: scale(1.08);
  }


  /* =========================
     PRICE
  ========================= */

  #tt-best-sellers-{{ section.id }} .tt-product-card__price {
    display: flex;
    align-items: center;
    gap: 5px;
  }


  #tt-best-sellers-{{ section.id }} .tt-product-card__price-current {
    font-size: 32px;
    line-height: 1;
    font-weight: 500;
    color: #111;
  }


  #tt-best-sellers-{{ section.id }} .tt-product-card__price-compare {
    font-size: 20px;
    line-height: 1;
    color: #777;
  }


  #tt-best-sellers-{{ section.id }} .tt-product-card__price-compare[hidden] {
    display: none !important;
  }


  /* =========================
     BOTTOM NAVIGATION
  ========================= */

  #tt-best-sellers-{{ section.id }} .tt-best-sellers__bottom {
    height: 65px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 10px;
    border-top: 1px solid #111;
  }


  /* DOTS */

  #tt-best-sellers-{{ section.id }} .tt-best-sellers__dots {
    display: flex;
    align-items: center;
    gap: 5px;
  }


  #tt-best-sellers-{{ section.id }} .tt-best-sellers__dot {
    width: 10px;
    height: 10px;

    padding: 0;

    border: 1px solid #111;
    border-radius: 50%;

    background: transparent;
    cursor: pointer;
  }


  #tt-best-sellers-{{ section.id }} .tt-best-sellers__dot.is-active {
    background: #111;
  }


  /* ARROWS */

  #tt-best-sellers-{{ section.id }} .tt-best-sellers__arrows {
    display: flex;
    align-items: center;
    gap: 18px;
  }


  #tt-best-sellers-{{ section.id }} .tt-best-sellers__arrow {
    width: 22px;
    height: 22px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 0;
    background: transparent;

    cursor: pointer;
  }


  #tt-best-sellers-{{ section.id }} .tt-best-sellers__arrow-image {
    width: 40px;
    height: auto;
    display: block;
  }


  /* =========================
     TABLET
  ========================= */

  @media screen and (max-width: 1200px) {

    #tt-best-sellers-{{ section.id }} .tt-best-sellers__product {
      flex-basis: 25%;
    }

  }


  /* =========================
     MOBILE
  ========================= */

  @media screen and (max-width: 749px) {

    #tt-best-sellers-{{ section.id }} .tt-best-sellers__heading {
      height: 52px;
      padding: 0 6px;
    }


    #tt-best-sellers-{{ section.id }} .tt-best-sellers__heading h2 {
      font-size: 30px;
    }


    #tt-best-sellers-{{ section.id }} .tt-best-sellers__product {
      flex: 0 0 100%;
    }


    #tt-best-sellers-{{ section.id }} .tt-product-card__image-wrapper {
      height: 350px;
    }


    #tt-best-sellers-{{ section.id }} .tt-product-card__image {
      padding: 20px;
    }


    #tt-best-sellers-{{ section.id }} .tt-product-card__content {
      min-height: 118px;
      padding: 10px 8px;
    }


    #tt-best-sellers-{{ section.id }} .tt-product-card__title {
      font-size: 20px;
      margin-bottom: 12px;
    }


    #tt-best-sellers-{{ section.id }} .tt-product-card__swatches {
      margin-bottom: 10px;
    }


    #tt-best-sellers-{{ section.id }} .tt-product-card__swatch {
      width: 30px;
      height: 30px;
      flex-basis: 30px;
    }


    #tt-best-sellers-{{ section.id }} .tt-product-card__price-current {
      font-size: 20px;
    }


    #tt-best-sellers-{{ section.id }} .tt-best-sellers__bottom {
      height: 70px;
    }

  }

{% endstyle %}



<script>

(() => {

  const section = document.querySelector(
    '#tt-best-sellers-{{ section.id }}'
  );

  if (!section) return;

  if (section.dataset.sliderInitialized === 'true') return;

  section.dataset.sliderInitialized = 'true';


  /* =========================
     ELEMENTS
  ========================= */

  const track = section.querySelector(
    '.tt-best-sellers__products'
  );

  const products = [
    ...section.querySelectorAll(
      '.tt-best-sellers__product'
    )
  ];

  const dotsContainer = section.querySelector(
    '.tt-best-sellers__dots'
  );

  const prevButton = section.querySelector(
    '.tt-best-sellers__prev'
  );

  const nextButton = section.querySelector(
    '.tt-best-sellers__next'
  );


  if (!track || !products.length) return;


  let slidesPerView = 1;
  let totalPages = 1;
  let currentPage = 0;


  /* =========================
     SLIDER
  ========================= */

  function getSlidesPerView() {

    if (window.innerWidth > 1200) {
      return 5;
    }

    if (window.innerWidth > 749) {
      return 4;
    }

    return 1;

  }


  function setupDots() {

    slidesPerView = getSlidesPerView();

    totalPages = Math.ceil(
      products.length / slidesPerView
    );

    if (!dotsContainer) return;

    dotsContainer.innerHTML = '';


    for (
      let i = 0;
      i < totalPages;
      i++
    ) {

      const dot = document.createElement('button');

      dot.type = 'button';

      dot.className =
        'tt-best-sellers__dot';


      if (i === currentPage) {

        dot.classList.add('is-active');

      }


      dot.setAttribute(
        'aria-label',
        `Go to slide ${i + 1}`
      );


      dot.addEventListener('click', () => {

        currentPage = i;

        goToPage();

      });


      dotsContainer.appendChild(dot);

    }

  }


  function updateDots() {

    if (!dotsContainer) return;

    const dots = [
      ...dotsContainer.querySelectorAll(
        '.tt-best-sellers__dot'
      )
    ];


    dots.forEach((dot, index) => {

      dot.classList.toggle(
        'is-active',
        index === currentPage
      );

    });

  }


  function goToPage() {

    if (!products.length) return;

    const productWidth =
      products[0].getBoundingClientRect().width;


    const scrollAmount =
      productWidth *
      slidesPerView *
      currentPage;


    track.scrollTo({
      left: scrollAmount,
      behavior: 'smooth'
    });


    updateDots();

  }


  /* =========================
     NEXT BUTTON
  ========================= */

  if (nextButton) {

    nextButton.addEventListener('click', () => {

      if (currentPage < totalPages - 1) {

        currentPage++;

      } else {

        currentPage = 0;

      }


      goToPage();

    });

  }


  /* =========================
     PREVIOUS BUTTON
  ========================= */

  if (prevButton) {

    prevButton.addEventListener('click', () => {

      if (currentPage > 0) {

        currentPage--;

      } else {

        currentPage = totalPages - 1;

      }


      goToPage();

    });

  }


  /* =========================
     COLOR VARIANT CHANGE
  ========================= */

  const productCards = section.querySelectorAll(
    '.tt-product-card'
  );


  productCards.forEach((card) => {


    const mainImage = card.querySelector(
      '.tt-product-card__main-image'
    );


    const swatches = card.querySelectorAll(
      '.tt-product-card__swatch'
    );


    const currentPrice = card.querySelector(
      '.tt-product-card__price-current'
    );


    const comparePrice = card.querySelector(
      '.tt-product-card__price-compare'
    );


    const discountBadge = card.querySelector(
      '.tt-product-card__badge--discount'
    );


    if (!swatches.length) return;


    let isAnimating = false;


    function updateVariant(swatch) {


      /* =========================
         ACTIVE SWATCH
      ========================= */

      swatches.forEach((item) => {

        item.classList.remove('is-active');

      });


      swatch.classList.add('is-active');


      /* =========================
         PRICE
      ========================= */

      const newPrice =
        swatch.getAttribute('data-price');


      if (
        currentPrice &&
        newPrice
      ) {

        currentPrice.textContent = newPrice;

      }


      /* =========================
         COMPARE PRICE
      ========================= */

      const newComparePrice =
        swatch.getAttribute('data-compare-price');


      if (comparePrice) {

        if (
          newComparePrice &&
          newComparePrice.trim() !== ''
        ) {

          comparePrice.textContent =
            newComparePrice;

          comparePrice.hidden = false;

        } else {

          comparePrice.textContent = '';

          comparePrice.hidden = true;

        }

      }


      /* =========================
         DISCOUNT BADGE
      ========================= */

      if (discountBadge) {

        const discount = parseInt(
          swatch.getAttribute('data-discount') || '0',
          10
        );


        if (discount > 0) {

          discountBadge.textContent =
            `-${discount}%`;

          discountBadge.hidden = false;

        } else {

          discountBadge.textContent = '';

          discountBadge.hidden = true;

        }

      }


      /* =========================
         IMAGE CHANGE
      ========================= */

      const newImage =
        swatch.getAttribute('data-image');


      if (!mainImage) return;

      if (!newImage) return;


      const currentImage =
        mainImage.currentSrc ||
        mainImage.src ||
        '';


      const currentImagePath =
        currentImage.split('?')[0];


      const newImagePath =
        newImage.split('?')[0];


      if (
        currentImagePath === newImagePath
      ) {

        return;

      }


      if (isAnimating) return;


      isAnimating = true;


      /* REMOVE SRCSET */

      mainImage.removeAttribute('srcset');

      mainImage.removeAttribute('sizes');


      /* SLIDE OUT */

      mainImage.classList.remove(
        'is-sliding-in'
      );

      mainImage.classList.add(
        'is-sliding-out'
      );


      const preloadImage = new Image();


      function showNewImage() {


        mainImage.src = newImage;


        mainImage.classList.remove(
          'is-sliding-out'
        );


        mainImage.classList.add(
          'is-sliding-in'
        );


        requestAnimationFrame(() => {

          requestAnimationFrame(() => {

            mainImage.classList.remove(
              'is-sliding-in'
            );

          });

        });


        setTimeout(() => {

          isAnimating = false;

        }, 350);

      }


      /* WAIT FOR IMAGE */

      preloadImage.onload = () => {

        setTimeout(() => {

          showNewImage();

        }, 180);

      };


      /* FALLBACK */

      preloadImage.onerror = () => {

        setTimeout(() => {

          showNewImage();

        }, 180);

      };


      preloadImage.src = newImage;

    }


    /* =========================
       DESKTOP HOVER
    ========================= */

    swatches.forEach((swatch) => {

      swatch.addEventListener(
        'mouseenter',
        () => {

          updateVariant(swatch);

        }
      );


      /* =========================
         MOBILE CLICK
      ========================= */

      swatch.addEventListener(
        'click',
        (event) => {

          event.preventDefault();

          updateVariant(swatch);

        }
      );

    });

  });


  /* =========================
     RESIZE
  ========================= */

  let resizeTimer;


  window.addEventListener('resize', () => {

    clearTimeout(resizeTimer);


    resizeTimer = setTimeout(() => {

      currentPage = 0;

      setupDots();

      goToPage();

    }, 150);

  });


  /* =========================
     INITIALIZE
  ========================= */

  setupDots();

})();
</script>



