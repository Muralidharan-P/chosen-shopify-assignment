<section
  id="tt-image-content-{{ section.id }}"
  class="tt-image-content"
  style="
    --tt-button-text: {{ section.settings.button_text_color }};
    --tt-button-bg: {{ section.settings.button_background }};
    --tt-button-hover-text: {{ section.settings.button_hover_text_color }};
    --tt-button-hover-bg: {{ section.settings.button_hover_background }};
  "
>
  <div class="tt-image-content__inner">

    <!-- IMAGE -->
    <div class="tt-image-content__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1200, 1600, 2000',
            class: 'tt-image-content__image',
            alt: section.settings.image.alt
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'tt-image-content__placeholder' }}
      {% endif %}
    </div>

    <!-- CONTENT -->
    <div class="tt-image-content__content">
      <div class="tt-image-content__content-inner">

        {% if section.settings.heading != blank %}
          <h2 class="tt-image-content__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="tt-image-content__text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="tt-hero__button"
          >
            <span class="tt-hero__button-text">
              {{ section.settings.button_label }}
            </span>

            <img
              src="https://cdn.shopify.com/s/files/1/0698/2320/1351/files/Arrow.svg?v=1787057669"
              alt=""
              class="tt-hero__button-icon"
              width="18"
              height="18"
              loading="lazy"
            >
          </a>
        {% endif %}

      </div>
    </div>

  </div>
</section>


{% style %}

/* =========================================
   IMAGE WITH CONTENT
   PARENT
========================================= */

#tt-image-content-{{ section.id }} {
  width: 100%;
  overflow: hidden;

  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  padding-left: {{ section.settings.padding_left }}px;
  padding-right: {{ section.settings.padding_right }}px;

  background: {{ section.settings.section_background }};
}

#tt-image-content-{{ section.id }} .tt-image-content__inner {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: {{ section.settings.desktop_height }}px;
}


/* =========================================
   IMAGE
========================================= */
.tt-image-content__content{
  border-bottom:1px solid;
}
#tt-image-content-{{ section.id }} .tt-image-content__media {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: {{ section.settings.desktop_height }}px;
  overflow: hidden;
}

#tt-image-content-{{ section.id }} .tt-image-content__image,
#tt-image-content-{{ section.id }} .tt-image-content__placeholder {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position:
    {{ section.settings.image_position_x }}%
    {{ section.settings.image_position_y }}%;
}


/* =========================================
   CONTENT
========================================= */

#tt-image-content-{{ section.id }} .tt-image-content__content {
  display: flex;
  align-items: {{ section.settings.content_vertical_alignment }};
  justify-content: flex-start;

  background: {{ section.settings.content_background }};

  padding-top: {{ section.settings.content_padding_top }}px;
  padding-right: {{ section.settings.content_padding_right }}px;
  padding-bottom: {{ section.settings.content_padding_bottom }}px;
  padding-left: {{ section.settings.content_padding_left }}px;
}

#tt-image-content-{{ section.id }} .tt-image-content__content-inner {
  width: 100%;
  max-width: {{ section.settings.content_max_width }}px;
}


/* =========================================
   HEADING
========================================= */

#tt-image-content-{{ section.id }} .tt-image-content__heading {
  margin: 0 0 {{ section.settings.heading_bottom_spacing }}px;

  font-family: inherit;
  font-size: {{ section.settings.heading_size }}px;
  font-weight: 500;
  line-height: {{ section.settings.heading_line_height }};
  letter-spacing: -0.04em;

  color: {{ section.settings.heading_color }};
}


/* =========================================
   TEXT
========================================= */

#tt-image-content-{{ section.id }} .tt-image-content__text {
  margin: 0;

  font-family: inherit;
  font-size: {{ section.settings.text_size }}px;
  font-weight: 500;
  line-height: {{ section.settings.text_line_height }};

  color: {{ section.settings.text_color }};
}

#tt-image-content-{{ section.id }} .tt-image-content__text p {
  margin: 0;
}


/* =========================================
   BUTTON
   Existing tt-hero__button style is reused
========================================= */


.tt-image-content .tt-hero__button{
    background:#000;
    color:#fff;
}

.tt-image-content .tt-hero__button:hover{

    color:#000;
}

.tt-image-content .tt-hero__button-icon{
    filter: invert(1);
}
.tt-image-content .tt-hero__button:hover .tt-hero__button-icon{
    filter: invert(0);
}
.tt-image-content .tt-hero__button::before{
    background:#fff;
}

#tt-image-content-{{ section.id }} .tt-hero__button {
  margin-top: {{ section.settings.button_top_spacing }}px;
}


/* =========================================
   TABLET
========================================= */

@media screen and (max-width: 1200px) {

  #tt-image-content-{{ section.id }} .tt-image-content__heading {
    font-size: {{ section.settings.heading_size | times: 0.88 | round }}px;
  }

  #tt-image-content-{{ section.id }} .tt-image-content__text {
    font-size: {{ section.settings.text_size | times: 0.92 | round }}px;
  }

}


/* =========================================
   MOBILE
   CONTENT TOP
   IMAGE BOTTOM
========================================= */

@media screen and (max-width: 749px) {

  #tt-image-content-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    padding-left: {{ section.settings.mobile_padding_left }}px;
    padding-right: {{ section.settings.mobile_padding_right }}px;
  }

  #tt-image-content-{{ section.id }} .tt-image-content__inner {
    display: flex;
    flex-direction: column;

    min-height: auto;
  }


  /* Content comes first on mobile */
  #tt-image-content-{{ section.id }} .tt-image-content__content {
    order: 1;

    min-height: {{ section.settings.mobile_content_height }}px;

    padding-top: {{ section.settings.mobile_content_padding_top }}px;
    padding-right: {{ section.settings.mobile_content_padding_right }}px;
    padding-bottom: {{ section.settings.mobile_content_padding_bottom }}px;
    padding-left: {{ section.settings.mobile_content_padding_left }}px;
  }


  /* Image comes below content */
  #tt-image-content-{{ section.id }} .tt-image-content__media {
    order: 2;

    height: {{ section.settings.mobile_image_height }}px;
    min-height: 0;
  }


  #tt-image-content-{{ section.id }} .tt-image-content__heading {
    font-size: {{ section.settings.mobile_heading_size }}px;
    line-height: {{ section.settings.mobile_heading_line_height }};
    margin-bottom: {{ section.settings.mobile_heading_bottom_spacing }}px;
  }


  #tt-image-content-{{ section.id }} .tt-image-content__text {
    font-size: {{ section.settings.mobile_text_size }}px;
    line-height: {{ section.settings.mobile_text_line_height }};
  }


  #tt-image-content-{{ section.id }} .tt-hero__button {
    margin-top: {{ section.settings.mobile_button_top_spacing }}px;
  }

}

{% endstyle %}


