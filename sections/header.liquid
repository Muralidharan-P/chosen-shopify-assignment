{% comment %}
  Custom Track & Tread Header
{% endcomment %}

<header class="tt-header">
  <div class="tt-header__inner">

    <!-- Mobile Menu Button -->
    <button
      class="tt-menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
    </button>

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="tt-header__logo">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 500
          | image_tag:
            loading: 'eager',
            alt: shop.name,
            widths: '150, 200, 300, 400, 500'
        }}
      {% else %}
        {{ shop.name }}
      {% endif %}
    </a>

    <!-- Desktop Navigation -->
    <nav class="tt-header__nav" aria-label="Main navigation">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" class="tt-header__link">
            {{ link.title }}
          </a>
        {% endfor %}
      {% endif %}
    </nav>

    <!-- Search -->
    <a href="{{ routes.search_url }}" class="tt-header__search">
      Search
    </a>

    <!-- Login -->
    {% if shop.customer_accounts_enabled %}
      <a href="{{ routes.account_login_url }}" class="tt-header__login">
        {% if customer %}
          Account
        {% else %}
          Log In
        {% endif %}
      </a>
    {% endif %}

    <!-- Cart -->
    <a href="{{ routes.cart_url }}" class="tt-header__cart">
      Cart (<span class="cart-count">{{ cart.item_count }}</span>)
    </a>

  </div>

  <!-- Mobile Navigation -->
  <div class="tt-mobile-menu" hidden>
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="tt-mobile-menu__link">
          {{ link.title }}
        </a>
      {% endfor %}
    {% endif %}

    {% if shop.customer_accounts_enabled %}
      <a href="{{ routes.account_login_url }}" class="tt-mobile-menu__link">
        Log In
      </a>
    {% endif %}
  </div>
</header>

<style>
/* ================================
   HEADER
================================ */

.tt-header {
  width: 100%;
  background: #F2F2F2;
  border-bottom: 1px solid #000;
  position: relative;
  z-index: 100;
}

.tt-header__inner {
  min-height: 60px;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  align-items: center;
}

/* Common header items */
.tt-header__logo,
.tt-header__search,
.tt-header__login,
.tt-header__cart,
.tt-header__link {
  color: #161616;
  text-decoration: none;
  font-size: clamp(16px, 1.25vw, 24px);
  line-height: 1;
  white-space: nowrap;
}

/* Logo */
.tt-header__logo {
  grid-column: 1;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 16px;
}

.tt-header__logo img {
  display: block;
  width: auto;
  max-width: 180px;
  max-height: 30px;
  height: auto;
}

/* Desktop navigation */
.tt-header__nav {
  grid-column: 2 / 5;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  height: 100%;
}

.tt-header__link {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Search */
.tt-header__search {
  grid-column: 5;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Login */
.tt-header__login {
  grid-column: 6;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Cart */
.tt-header__cart {
  grid-column: 7;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 16px;
}

/* Hover */
.tt-header a:hover {
  opacity: 0.6;
}

/* Hide mobile elements on desktop */
.tt-menu-toggle,
.tt-mobile-menu {
  display: none;
}





/* ================================
   TABLET + MOBILE
   HAMBURGER BELOW 1200PX
================================ */

@media screen and (max-width: 1199px) {

  .tt-header__inner {
    min-height: 56px;
    grid-template-columns: 40px minmax(0, 1fr) auto auto;
    column-gap: clamp(10px, 2vw, 24px);
    padding: 0 clamp(12px, 2vw, 24px);
  }

  /* 2 line hamburger */
  .tt-menu-toggle {
    grid-column: 1;
    display: flex;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    cursor: pointer;
  }

  .tt-menu-toggle span {
    display: block;
    width: 24px;
    height: 1.5px;
    background: #161616;
  }

  /* Logo */
  .tt-header__logo {
    grid-column: 2;
    padding-left: 0;
    justify-content: flex-start;
  }

  /* Hide desktop navigation and login */
  .tt-header__nav,
  .tt-header__login {
    display: none;
  }

  /* Search */
  .tt-header__search {
    grid-column: 3;
  }

  /* Cart */
  .tt-header__cart {
    grid-column: 4;
    padding-right: 0;
    justify-content: flex-end;
  }

  /* Mobile menu */
  .tt-mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: #fff;
    border-bottom: 1px solid #000;
    padding: 20px;
  }

  .tt-mobile-menu:not([hidden]) {
    display: flex;
    flex-direction: column;
  }
  .tt-hero__button{
    padding:18px !important;
    font-size:20px !important;
  }

  .tt-mobile-menu__link {
    padding: 14px 0;
    color: #161616;
    text-decoration: none;
    font-size: clamp(18px, 2vw, 24px);
    border-bottom: 1px solid #ddd;
  }
}


/* ================================
   SMALL MOBILE
================================ */

@media screen and (max-width: 480px) {

  .tt-header__inner {
    min-height: 56px;
    grid-template-columns: 28px minmax(0, 1fr) auto auto;
    column-gap: 10px;
    padding: 0 12px;
  }

  .tt-menu-toggle {
    width: 28px;
  }

  .tt-menu-toggle span {
    width: 24px;
  }

  .tt-header__logo,
  .tt-header__search,
  .tt-header__cart {
    font-size: clamp(16px, 4vw, 24px);
  }

  .tt-header__logo img {
    max-width: 160px;
    max-height: 28px;
  }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const toggle = document.querySelector('.tt-menu-toggle');
    const mobileMenu = document.querySelector('.tt-mobile-menu');

    if (toggle && mobileMenu) {
      toggle.addEventListener('click', function () {
        const isOpen = !mobileMenu.hasAttribute('hidden');

        if (isOpen) {
          mobileMenu.setAttribute('hidden', '');
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          mobileMenu.removeAttribute('hidden');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Track & Tread Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu"
    }
  ]
}
{% endschema %}