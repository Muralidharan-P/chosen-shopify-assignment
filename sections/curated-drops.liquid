<section
  id="tt-curated-drops-{{ section.id }}"
  class="tt-curated-drops"
>
  <div class="tt-curated-drops__inner">

    {% if section.settings.heading != blank %}
      <div class="tt-curated-drops__heading-wrap">
        <h2 class="tt-curated-drops__heading">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}


    <div class="tt-curated-drops__grid">

      <!-- CARD 1 -->
      <div class="tt-curated-drops__card">
        <div class="tt-curated-drops__image-wrap">

          {% if section.settings.image_1 != blank %}
            {{
              section.settings.image_1
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1600',
                class: 'tt-curated-drops__image',
                alt: section.settings.button_text_1
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'tt-curated-drops__placeholder' }}
          {% endif %}


          {% if section.settings.button_text_1 != blank %}
            <div class="tt-curated-drops__button-wrap">

              <a
                href="{{ section.settings.button_link_1 | default: '#' }}"
                class="tt-button tt-curated-drops__button"
              >
                <span>{{ section.settings.button_text_1 }}</span>

                {% if section.settings.arrow_text != blank %}
                  <span class="tt-curated-drops__button-arrow">
                    {{ section.settings.arrow_text }}
                  </span>
                {% endif %}
              </a>

            </div>
          {% endif %}

        </div>
      </div>


      <!-- CARD 2 -->
      <div class="tt-curated-drops__card">
        <div class="tt-curated-drops__image-wrap">

          {% if section.settings.image_2 != blank %}
            {{
              section.settings.image_2
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1600',
                class: 'tt-curated-drops__image',
                alt: section.settings.button_text_2
            }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'tt-curated-drops__placeholder' }}
          {% endif %}


          {% if section.settings.button_text_2 != blank %}
            <div class="tt-curated-drops__button-wrap">

              <a
                href="{{ section.settings.button_link_2 | default: '#' }}"
                class="tt-button tt-curated-drops__button"
              >
                <span>{{ section.settings.button_text_2 }}</span>

                {% if section.settings.arrow_text != blank %}
                  <span class="tt-curated-drops__button-arrow">
                    {{ section.settings.arrow_text }}
                  </span>
                {% endif %}
              </a>

            </div>
          {% endif %}

        </div>
      </div>

    </div>

  </div>
</section>


{% style %}

  /* =========================================
     CURATED DROPS - PARENT
  ========================================= */

  #tt-curated-drops-{{ section.id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
    overflow: hidden;
  }


  #tt-curated-drops-{{ section.id }} .tt-curated-drops__inner {
    width: 100%;
  }


  /* =========================================
     HEADING
  ========================================= */

  #tt-curated-drops-{{ section.id }} .tt-curated-drops__heading-wrap {
    padding-bottom: {{ section.settings.heading_bottom_spacing }}px;
  }


  #tt-curated-drops-{{ section.id }} .tt-curated-drops__heading {
    margin: 0;

    font-family: inherit;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;

    color: {{ section.settings.heading_color }};
  }


  /* =========================================
     GRID
  ========================================= */

  #tt-curated-drops-{{ section.id }} .tt-curated-drops__grid {
    width: 100%;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }


  #tt-curated-drops-{{ section.id }} .tt-curated-drops__card {
    min-width: 0;
  }


  /* =========================================
     IMAGE
  ========================================= */

  #tt-curated-drops-{{ section.id }} .tt-curated-drops__image-wrap {
    position: relative;

    width: 100%;
    height: {{ section.settings.image_height }}px;

    overflow: hidden;
  }


  #tt-curated-drops-{{ section.id }} .tt-curated-drops__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    transform: scale(1);

    transition:
      transform {{ section.settings.zoom_speed }}ms ease;
  }


  /* SMOOTH ZOOM HOVER */

  #tt-curated-drops-{{ section.id }}
  .tt-curated-drops__card:hover
  .tt-curated-drops__image {
    transform: scale({{ section.settings.zoom_scale }});
  }


  #tt-curated-drops-{{ section.id }} .tt-curated-drops__placeholder {
    display: block;

    width: 100%;
    height: 100%;
  }


  /* =========================================
     BUTTON POSITION
  ========================================= */

  #tt-curated-drops-{{ section.id }} .tt-curated-drops__button-wrap {
    position: absolute;
    z-index: 2;

    left: {{ section.settings.button_position_x }}%;
    top: {{ section.settings.button_position_y }}%;

    transform: translate(-50%, -50%);
  }


  /* =========================================
     BUTTON
     Uses existing tt-button style
  ========================================= */

  #tt-curated-drops-{{ section.id }} .tt-curated-drops__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    white-space: nowrap;
  }


  #tt-curated-drops-{{ section.id }} .tt-curated-drops__button-arrow {
    display: inline-block;
    line-height: 1;
  }


  /* =========================================
     TABLET
  ========================================= */

  @media screen and (max-width: 1200px) {

    #tt-curated-drops-{{ section.id }} .tt-curated-drops__heading {
      font-size: {{ section.settings.heading_size | times: 0.88 | round }}px;
    }


    #tt-curated-drops-{{ section.id }} .tt-curated-drops__image-wrap {
      height: {{ section.settings.image_height | times: 0.85 | round }}px;
    }

  }


  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 749px) {

    #tt-curated-drops-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      padding-left: {{ section.settings.mobile_padding_side }}px;
      padding-right: {{ section.settings.mobile_padding_side }}px;
    }


    #tt-curated-drops-{{ section.id }} .tt-curated-drops__heading-wrap {
      padding-bottom: {{ section.settings.mobile_heading_bottom_spacing }}px;
    }


    #tt-curated-drops-{{ section.id }} .tt-curated-drops__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }


    #tt-curated-drops-{{ section.id }} .tt-curated-drops__grid {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_grid_gap }}px;
    }


    #tt-curated-drops-{{ section.id }} .tt-curated-drops__image-wrap {
      height: {{ section.settings.mobile_image_height }}px;
    }

  }

{% endstyle %} 


{% schema %}
{
  "name": "Shop Curated Drops",
  "settings": [

    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
