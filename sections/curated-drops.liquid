      "default": 34,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading font size",
      "min": 18,
      "max": 60,
      "step": 1,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "label": "Heading bottom spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_heading_bottom_spacing",
      "label": "Mobile heading bottom spacing",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 8,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "First image"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "First image"
    },
    {
      "type": "text",
      "id": "button_text_1",
      "label": "First button text",
      "default": "Shop Women"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link"
    },

    {
      "type": "header",
      "content": "Second image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second image"
    },
    {
      "type": "text",
      "id": "button_text_2",
      "label": "Second button text",
      "default": "Shop Men"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },

    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "arrow_text",
      "label": "Arrow text",
      "default": "↗"
    },
    {
      "type": "range",
      "id": "button_position_x",
      "label": "Button horizontal position",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "button_position_y",
      "label": "Button vertical position",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 55,
      "unit": "%"
    },

    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Desktop image height",
      "min": 300,
      "max": 1000,
      "step": 10,
      "default": 560,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile image height",
      "min": 250,
      "max": 800,
      "step": 10,
      "default": 480,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Desktop image gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "label": "Mobile image gap",
      "min": 0,
