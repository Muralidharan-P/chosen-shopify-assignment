<section
  id="tt-curated-drops-{{ section.id }}"
  class="tt-curated-drops"
  style="
    --tt-button-text: {{ section.settings.button_text_color }};
    --tt-button-bg: {{ section.settings.button_background }};
    --tt-button-hover-text: {{ section.settings.button_hover_text_color }};
    --tt-button-hover-bg: {{ section.settings.button_hover_background }};
  "
>
  <div class="tt-curated-drops__inner">

    {% if section.settings.heading != blank %}
      <div class="tt-curated-drops__heading-wrap">
        <h2 class="tt-curated-drops__heading">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}


    <div class="tt-curated-drops__grid">

      <!-- CARD 1 -->
      <div class="tt-curated-drops__card">
        <div class="tt-curated-drops__image-wrap">

          {% if section.settings.image_1 != blank %}
            {{
              section.settings.image_1
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1600',
                class: 'tt-curated-drops__image',
                alt: section.settings.button_text_1
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'tt-curated-drops__placeholder' }}
          {% endif %}


          {% if section.settings.button_text_1 != blank %}
  <div class="tt-curated-drops__button-wrap">
    <a
      href="{{ section.settings.button_link_1 | default: '#' }}"
      class="tt-hero__button"
    >
      <span class="tt-hero__button-text">
        {{ section.settings.button_text_1 }}
      </span>

      <img
        src="https://cdn.shopify.com/s/files/1/0698/2320/1351/files/Arrow.svg?v=1787057669"
        alt=""
        class="tt-hero__button-icon"
        width="18"
        height="18"
        loading="lazy"
      >
    </a>
  </div>
{% endif %}

        </div>
      </div>


      <!-- CARD 2 -->
      <div class="tt-curated-drops__card">
        <div class="tt-curated-drops__image-wrap">

          {% if section.settings.image_2 != blank %}
            {{
              section.settings.image_2
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1600',
                class: 'tt-curated-drops__image',
                alt: section.settings.button_text_2
            }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'tt-curated-drops__placeholder' }}
          {% endif %}


          {% if section.settings.button_text_2 != blank %}
  <div class="tt-curated-drops__button-wrap">
    <a
      href="{{ section.settings.button_link_2 | default: '#' }}"
      class="tt-hero__button"
    >
      <span class="tt-hero__button-text">
        {{ section.settings.button_text_2 }}
      </span>

      <img
        src="https://cdn.shopify.com/s/files/1/0698/2320/1351/files/Arrow.svg?v=1787057669"
        alt=""
        class="tt-hero__button-icon"
        width="18"
        height="18"
        loading="lazy"
      >
    </a>
  </div>
{% endif %}

        </div>
      </div>

    </div>

  </div>
</section>


{% style %}

  /* =========================================
     CURATED DROPS - PARENT
  ========================================= */

  #tt-curated-drops-{{ section.id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
    overflow: hidden;
  }


  #tt-curated-drops-{{ section.id }} .tt-curated-drops__inner {
    width: 100%;
  }


  /* =========================================
     HEADING
  ========================================= */

  #tt-curated-drops-{{ section.id }} .tt-curated-drops__heading-wrap {
    padding-bottom: {{ section.settings.heading_bottom_spacing }}px;
  }


  #tt-curated-drops-{{ section.id }} .tt-curated-drops__heading {
    margin: 0;

    font-family: inherit;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;

    color: {{ section.settings.heading_color }};
  }


  /* =========================================
     GRID
  ========================================= */

  #tt-curated-drops-{{ section.id }} .tt-curated-drops__grid {
    width: 100%;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }


  #tt-curated-drops-{{ section.id }} .tt-curated-drops__card {
    min-width: 0;
  }


  /* =========================================
     IMAGE
  ========================================= */

  #tt-curated-drops-{{ section.id }} .tt-curated-drops__image-wrap {
    position: relative;

    width: 100%;
    height: {{ section.settings.image_height }}px;

    overflow: hidden;
  }


  #tt-curated-drops-{{ section.id }} .tt-curated-drops__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    transform: scale(1);

    transition:
      transform {{ section.settings.zoom_speed }}ms ease;
  }


  /* SMOOTH ZOOM HOVER */

  #tt-curated-drops-{{ section.id }}
  .tt-curated-drops__card:hover
  .tt-curated-drops__image {
    transform: scale({{ section.settings.zoom_scale }});
  }


  #tt-curated-drops-{{ section.id }} .tt-curated-drops__placeholder {
    display: block;

    width: 100%;
    height: 100%;
  }


  /* =========================================
     BUTTON POSITION
  ========================================= */

  #tt-curated-drops-{{ section.id }} .tt-curated-drops__button-wrap {
    position: absolute;
    z-index: 2;

    left: {{ section.settings.button_position_x }}%;
    top: {{ section.settings.button_position_y }}%;

    transform: translate(-50%, -50%);
        width: 100%;

    text-align: center;
  }




  .tt-hero__button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 24px 32px;
  overflow: hidden;
  background: #F2F2F2;
  color: #000;
  text-decoration: none;
  font-size: 24px;
  line-height: 1;
  isolation: isolate;
  transition: color 0.5s ease;
  border:1px solid #000;

}

/* Oval fill animation */
.tt-hero__button::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -220%;
  width: 220%;
  height: 220%;
  background: #000;
  border-radius: 50% 50% 0 0;
  transform: translateX(-50%);
  transition: bottom 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  z-index: 0;
}

.tt-hero__button:hover {
  color: #fff;
}

.tt-hero__button:hover::before {
  bottom: -55%;
}

/* Keep content above fill */
.tt-hero__button-text,
.tt-hero__button-icon {
  position: relative;
  z-index: 1;
}

/* Arrow image */
.tt-hero__button-icon {
  display: block;
  width: 20px;
  height: 20px;
  object-fit: contain;
  transition: transform 0.35s ease;
}

.tt-hero__button:hover .tt-hero__button-icon {
  transform: translate(3px, -3px);
  filter: invert(1);
}


  /* =========================================
     TABLET
  ========================================= */

  @media screen and (max-width: 1200px) {

    #tt-curated-drops-{{ section.id }} .tt-curated-drops__heading {
      font-size: {{ section.settings.heading_size | times: 0.88 | round }}px;
    }


    #tt-curated-drops-{{ section.id }} .tt-curated-drops__image-wrap {
      height: {{ section.settings.image_height | times: 0.85 | round }}px;
    }

  }


  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 749px) {

    #tt-curated-drops-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      padding-left: {{ section.settings.mobile_padding_side }}px;
      padding-right: {{ section.settings.mobile_padding_side }}px;
    }


    #tt-curated-drops-{{ section.id }} .tt-curated-drops__heading-wrap {
      padding-bottom: {{ section.settings.mobile_heading_bottom_spacing }}px;
    }


    #tt-curated-drops-{{ section.id }} .tt-curated-drops__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      padding-top:30px;
      padding-left:10px;
      padding-bottom:15px;
    }


    #tt-curated-drops-{{ section.id }} .tt-curated-drops__grid {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_grid_gap }}px;
    }


    #tt-curated-drops-{{ section.id }} .tt-curated-drops__image-wrap {
      height: {{ section.settings.mobile_image_height }}px;
    }

  }

{% endstyle %} 


{% schema %}
