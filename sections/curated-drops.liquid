      "step": 0.01,
      "default": 1.05
    },
    {
      "type": "range",
      "id": "zoom_speed",
      "label": "Zoom animation speed",
      "min": 100,
      "max": 1500,
      "step": 50,
      "default": 600,
      "unit": "ms"
