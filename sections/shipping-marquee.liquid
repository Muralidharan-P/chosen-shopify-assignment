{% style %}
  #shipping-marquee-{{ section.id }} {
    background: {{ section.settings.background_color }};
    overflow: hidden;
    width: 100%;
  }

  #shipping-marquee-{{ section.id }} .shipping-marquee__track {
    display: flex;
    width: max-content;
    animation: shipping-marquee-scroll 25s linear infinite;
    will-change: transform;
  }

  #shipping-marquee-{{ section.id }} .shipping-marquee__group {
    display: flex;
    flex-shrink: 0;
  }

  #shipping-marquee-{{ section.id }} .shipping-marquee__item {
    display: flex;
    align-items: center;
    gap: 24px;
    white-space: nowrap;

    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;

    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.font_size }}px;
    line-height: 1;
  }

  #shipping-marquee-{{ section.id }} .shipping-marquee__dot {
    display: inline-block;
    font-size: 18px;
    line-height: 1;
  }

  @keyframes shipping-marquee-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  #shipping-marquee-{{ section.id }}:hover .shipping-marquee__track {
    animation-play-state: paused;
  }

  @media screen and (max-width: 749px) {
    #shipping-marquee-{{ section.id }} .shipping-marquee__item {
      gap: 16px;
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      font-size: {{ section.settings.mobile_font_size }}px;
    }

    #shipping-marquee-{{ section.id }} .shipping-marquee__dot {
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shipping-marquee-{{ section.id }} .shipping-marquee__track {
      animation: none;
    }
  }
{% endstyle %}

<section
  id="shipping-marquee-{{ section.id }}"
  class="shipping-marquee"
>
  <div class="shipping-marquee__track">

    <div class="shipping-marquee__group">
      {% for i in (1..6) %}
        <div class="shipping-marquee__item">
          <span>{{ section.settings.text }}</span>
          <span class="shipping-marquee__dot">•</span>
        </div>
      {% endfor %}
    </div>

    <div class="shipping-marquee__group" aria-hidden="true">
      {% for i in (1..6) %}
        <div class="shipping-marquee__item">
          <span>{{ section.settings.text }}</span>
          <span class="shipping-marquee__dot">•</span>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Shipping Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Marquee text",
      "default": "Free shipping on orders over $100"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#C5FA1F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop font size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Shipping Marquee"
    }
  ]
}
{% endschema %}