{% style %}
  #testimonials-{{ section.id }} {
    --test-bg: {{ section.settings.background_color }};
    --test-heading-color: {{ section.settings.heading_color }};
    --test-border-color: {{ section.settings.border_color }};
    --test-quote-color: {{ section.settings.quote_color }};
    --test-name-color: {{ section.settings.name_color }};

    background: var(--test-bg);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #testimonials-{{ section.id }} .testimonials__heading {
    margin: 0 0 24px;
    padding: 0 {{ section.settings.section_padding_horizontal }}px;

    color: var(--test-heading-color);
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  #testimonials-{{ section.id }} .testimonials__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;

    border-top: 1px solid var(--test-border-color);
    border-bottom: 1px solid var(--test-border-color);
  }

  #testimonials-{{ section.id }} .testimonials__track::-webkit-scrollbar {
    height: 4px;
  }

  #testimonials-{{ section.id }} .testimonials__track::-webkit-scrollbar-thumb {
    background: var(--test-border-color);
  }

  #testimonials-{{ section.id }} .testimonials__card {
    flex: 0 0 33.333%;
    box-sizing: border-box;
    scroll-snap-align: start;

    padding: {{ section.settings.card_padding_vertical }}px {{ section.settings.section_padding_horizontal }}px;
    border-right: 1px solid var(--test-border-color);
  }

  #testimonials-{{ section.id }} .testimonials__card:last-child {
    border-right: none;
  }

  #testimonials-{{ section.id }} .testimonials__quote {
    margin: 0;
    color: var(--test-quote-color);
    font-size: {{ section.settings.quote_font_size }}px;
    line-height: 1.45;
  }

  #testimonials-{{ section.id }} .testimonials__name {
    margin: 16px 0 0;
    color: var(--test-name-color);
    font-size: {{ section.settings.name_font_size }}px;
  }

  @media screen and (max-width: 749px) {
    #testimonials-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #testimonials-{{ section.id }} .testimonials__heading {
      padding: 0 {{ section.settings.mobile_section_padding_horizontal }}px;
      margin-bottom: 16px;
      font-size: {{ section.settings.mobile_heading_font_size }}px;
    }

    #testimonials-{{ section.id }} .testimonials__card {
      flex: 0 0 85%;
      padding: {{ section.settings.mobile_card_padding_vertical }}px {{ section.settings.mobile_section_padding_horizontal }}px;
    }

    #testimonials-{{ section.id }} .testimonials__quote {
      font-size: {{ section.settings.mobile_quote_font_size }}px;
    }

    #testimonials-{{ section.id }} .testimonials__name {
      font-size: {{ section.settings.mobile_name_font_size }}px;
    }
  }
{% endstyle %}

<section
  id="testimonials-{{ section.id }}"
  class="testimonials {{ section.settings.parent_class }}"
>
  {% if section.settings.heading != blank %}
    <h2 class="testimonials__heading">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  <div class="testimonials__track">
    {% for block in section.blocks %}
      <div class="testimonials__card" {{ block.shopify_attributes }}>
        {% if block.settings.quote != blank %}
          <p class="testimonials__quote">{{ block.settings.quote }}</p>
        {% endif %}

        {% if block.settings.name != blank %}
          <p class="testimonials__name">{{ block.settings.name }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "parent_class",
      "label": "Parent CSS class",
      "default": "testimonials-section"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "Desktop horizontal padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_section_padding_horizontal",
      "label": "Mobile horizontal padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the Fam"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1C1C1C"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading font weight",
      "default": "700",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Desktop heading font size",
      "min": 20,
      "max": 140,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_heading_font_size",
      "label": "Mobile heading font size",
      "min": 18,
      "max": 80,
      "step": 1,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Card layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider line color",
      "default": "#D8D8D8"
    },
    {
      "type": "range",
      "id": "card_padding_vertical",
      "label": "Desktop card vertical padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_card_padding_vertical",
      "label": "Mobile card vertical padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Quote text"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote text color",
      "default": "#1C1C1C"
    },
    {
      "type": "range",
      "id": "quote_font_size",
      "label": "Desktop quote font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_quote_font_size",
      "label": "Mobile quote font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Name text"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name text color",
      "default": "#8C8C8C"
    },
    {
      "type": "range",
      "id": "name_font_size",
      "label": "Desktop name font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_name_font_size",
      "label": "Mobile name font size",
      "min": 8,
      "max": 20,
      "step": 1,
      "default": 12,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This is hands-down the best thing I've bought all year."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name / location",
          "default": "First name, City"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
