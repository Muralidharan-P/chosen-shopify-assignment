{% liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
%}

<section
  id="tt-hero-{{ section.id }}"
  class="tt-hero"
  style="
    --tt-hero-height: {{ section.settings.desktop_height }}px;
    --tt-hero-mobile-height: {{ section.settings.mobile_height }}px;

    --tt-content-top: {{ section.settings.padding_top }}px;
    --tt-content-right: {{ section.settings.padding_right }}px;
    --tt-content-bottom: {{ section.settings.padding_bottom }}px;
    --tt-content-left: {{ section.settings.padding_left }}px;

    --tt-mobile-content-top: {{ section.settings.mobile_padding_top }}px;
    --tt-mobile-content-right: {{ section.settings.mobile_padding_right }}px;
    --tt-mobile-content-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --tt-mobile-content-left: {{ section.settings.mobile_padding_left }}px;

    --tt-heading-size: {{ section.settings.heading_size }}px;
    --tt-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;

    --tt-heading-color: {{ section.settings.heading_color }};
    --tt-button-text: {{ section.settings.button_text_color }};
    --tt-button-bg: {{ section.settings.button_background }};
    --tt-button-hover-text: {{ section.settings.button_hover_text_color }};
    --tt-button-hover-bg: {{ section.settings.button_hover_background }};
  "
>
  <div class="tt-hero__media">

    {% if desktop_image != blank %}
      {{
        desktop_image
        | image_url: width: 2400
        | image_tag:
          class: 'tt-hero__image tt-hero__image--desktop',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1440, 1800, 2400',
          sizes: '100vw',
          alt: desktop_image.alt
      }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'tt-hero__placeholder' }}
    {% endif %}

    {% if mobile_image != blank %}
      {{
        mobile_image
        | image_url: width: 1000
        | image_tag:
          class: 'tt-hero__image tt-hero__image--mobile',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '375, 550, 750, 1000',
          sizes: '100vw',
          alt: mobile_image.alt
      }}
    {% elsif desktop_image != blank %}
      {{
        desktop_image
        | image_url: width: 1000
        | image_tag:
          class: 'tt-hero__image tt-hero__image--mobile',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '375, 550, 750, 1000',
          sizes: '100vw',
          alt: desktop_image.alt
      }}
    {% endif %}

  </div>

  <div class="tt-hero__overlay"></div>

  <div class="tt-hero__content tt-hero__content--{{ section.settings.content_position }}">
    <div class="tt-hero__content-inner">

      {% if section.settings.heading != blank %}
<h1 class="tt-hero__heading tt-hero__heading--animate">
  {{ section.settings.heading }}
</h1>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
  href="{{ section.settings.button_link | default: '#' }}"
  class="tt-hero__button"
>
  <span class="tt-hero__button-text">
    {{ section.settings.button_label }}
  </span>

  <img
    src="https://cdn.shopify.com/s/files/1/0698/2320/1351/files/Arrow.svg?v=1787057669"
    alt=""
    class="tt-hero__button-icon"
    width="18"
    height="18"
    loading="lazy"
  >
</a>
      {% endif %}

    </div>
  </div>
</section>


<style>




/* =========================================
   HEADING WORD FADE UP ANIMATION
========================================= */

.tt-hero__heading--animate .tt-word {
  display: inline-block;
  opacity: 0;
  transform: translateY(40px);
  animation: ttWordFadeUp 0.7s ease forwards;
}

@keyframes ttWordFadeUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
  /* =========================================
     TT HERO - PARENT
  ========================================= */

  #tt-hero-{{ section.id }}.tt-hero {
    position: relative;
    width: 100%;
    height: var(--tt-hero-height);
    overflow: hidden;
  }


  /* =========================================
     TT HERO - MEDIA
  ========================================= */

  #tt-hero-{{ section.id }} .tt-hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #tt-hero-{{ section.id }} .tt-hero__image,
  #tt-hero-{{ section.id }} .tt-hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #tt-hero-{{ section.id }} .tt-hero__image--desktop {
    display: block;
  }

  #tt-hero-{{ section.id }} .tt-hero__image--mobile {
    display: none;
  }


  /* =========================================
     TT HERO - OVERLAY
  ========================================= */

  #tt-hero-{{ section.id }} .tt-hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }


  /* =========================================
     TT HERO - CONTENT
  ========================================= */

  #tt-hero-{{ section.id }} .tt-hero__content {
    position: relative;
    z-index: 2;

    width: 100%;
    height: 100%;

    display: flex;

    padding:
      var(--tt-content-top)
      var(--tt-content-right)
      var(--tt-content-bottom)
      var(--tt-content-left);
  }

  #tt-hero-{{ section.id }} .tt-hero__content--top-left {
    align-items: flex-start;
    justify-content: flex-start;
    text-align: left;
  }

  #tt-hero-{{ section.id }} .tt-hero__content--top-center {
    align-items: flex-start;
    justify-content: center;
    text-align: center;
  }

  #tt-hero-{{ section.id }} .tt-hero__content--top-right {
    align-items: flex-start;
    justify-content: flex-end;
    text-align: right;
  }

  #tt-hero-{{ section.id }} .tt-hero__content--center-left {
    align-items: end;
    justify-content: flex-start;
    text-align: left;
  }

  #tt-hero-{{ section.id }} .tt-hero__content--center {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  #tt-hero-{{ section.id }} .tt-hero__content--center-right {
    align-items: center;
    justify-content: flex-end;
    text-align: right;
  }

  #tt-hero-{{ section.id }} .tt-hero__content--bottom-left {
    align-items: flex-end;
    justify-content: flex-start;
    text-align: left;
  }

  #tt-hero-{{ section.id }} .tt-hero__content--bottom-center {
    align-items: flex-end;
    justify-content: center;
    text-align: center;
  }

  #tt-hero-{{ section.id }} .tt-hero__content--bottom-right {
    align-items: flex-end;
    justify-content: flex-end;
    text-align: right;
  }


  /* =========================================
     TT HERO - CONTENT INNER
  ========================================= */

  #tt-hero-{{ section.id }} .tt-hero__content-inner {
    max-width:1200px;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  #tt-hero-{{ section.id }} .tt-hero__content--top-center .tt-hero__content-inner,
  #tt-hero-{{ section.id }} .tt-hero__content--center .tt-hero__content-inner,
  #tt-hero-{{ section.id }} .tt-hero__content--bottom-center .tt-hero__content-inner {
    align-items: center;
  }

  #tt-hero-{{ section.id }} .tt-hero__content--top-right .tt-hero__content-inner,
  #tt-hero-{{ section.id }} .tt-hero__content--center-right .tt-hero__content-inner,
  #tt-hero-{{ section.id }} .tt-hero__content--bottom-right .tt-hero__content-inner {
    align-items: flex-end;
  }


  /* =========================================
     TT HERO - HEADING
  ========================================= */

  #tt-hero-{{ section.id }} .tt-hero__heading {
    margin: 0;

    color: var(--tt-heading-color);

    font-family: 'Inter Tight', sans-serif;
    font-weight: 500;
    font-size: var(--tt-heading-size);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }


  /* =========================================
   HERO BUTTON
========================================= */

.tt-hero__button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;

  padding: 24px 32px;

  overflow: hidden;

  background: var(--tt-button-bg);
  color: var(--tt-button-text);

  text-decoration: none;

  font-size: 24px;
  line-height: 1;

  isolation: isolate;

  transition: color 0.5s ease;
      margin-top: 30px;
}

/* Oval fill animation */
.tt-hero__button::before {
  content: "";

  position: absolute;
  left: 50%;
  bottom: -220%;

  width: 220%;
  height: 220%;

  background: var(--tt-button-hover-bg);

  border-radius: 50% 50% 0 0;

  transform: translateX(-50%);

  transition: bottom 0.6s cubic-bezier(0.65, 0, 0.35, 1);

  z-index: 0;
}

.tt-hero__button:hover {
  color: var(--tt-button-hover-text);
}

.tt-hero__button:hover::before {
  bottom: -55%;
}

/* Keep content above fill */
.tt-hero__button-text,
.tt-hero__button-icon {
  position: relative;
  z-index: 1;
}

/* Arrow image */
.tt-hero__button-icon {
  display: block;

  width: 20px;
  height: 20px;

  object-fit: contain;

  transition: transform 0.35s ease;
}

.tt-hero__button:hover .tt-hero__button-icon {
  transform: translate(3px, -3px);
  filter: invert(1);
}



  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 749px) {

    #tt-hero-{{ section.id }}.tt-hero {
      height: var(--tt-hero-mobile-height);
    }

    #tt-hero-{{ section.id }} .tt-hero__image--desktop {
      display: none;
    }

    #tt-hero-{{ section.id }} .tt-hero__image--mobile {
      display: block;
    }

    #tt-hero-{{ section.id }} .tt-hero__content {
      padding:
        var(--tt-mobile-content-top)
        var(--tt-mobile-content-right)
        var(--tt-mobile-content-bottom)
        var(--tt-mobile-content-left);
    }

    #tt-hero-{{ section.id }} .tt-hero__heading {
      font-size: var(--tt-mobile-heading-size);
      line-height: 1.08;
    }

  .tt-hero__button {
    gap: 10px;

    padding: 18px 24px;

    font-size: 20px;
  }

  .tt-hero__button-icon {
    width: 17px;
    height: 17px;
  }
  }


@media screen and (max-width: 480px) {

  .tt-hero__button {
    gap: 8px;

    padding: 16px 20px;

    font-size: 18px;
  }

  .tt-hero__button-icon {
    width: 16px;
    height: 16px;
  }
}

  @media screen and (prefers-reduced-motion: reduce) {

    #tt-hero-{{ section.id }} .tt-hero__button,
    #tt-hero-{{ section.id }} .tt-hero__button::before,
    #tt-hero-{{ section.id }} .tt-hero__button-icon {
      transition: none;
    }
  }
</style>
<script>
  (() => {
    const section = document.querySelector('#tt-hero-{{ section.id }}');

    if (!section) return;

    const heading = section.querySelector('.tt-hero__heading--animate');

    if (!heading) return;

    const text = heading.textContent.trim();

    heading.innerHTML = '';

    const words = text.split(/\s+/);

    words.forEach((word, index) => {
      const wordSpan = document.createElement('span');

      wordSpan.className = 'tt-word';
      wordSpan.textContent = word;

      wordSpan.style.animationDelay = `${index * 0.12}s`;

      heading.appendChild(wordSpan);

      if (index < words.length - 1) {
        heading.appendChild(document.createTextNode(' '));
      }
    });
  })();
</script>

{% schema %}
